
# ==========================================
# Cấu hình MySQL
# ==========================================

# Địa chỉ kết nối MySQL.
DB_URL=jdbc:mysql://localhost:3306/phone_store

# Tài khoản MySQL.
DB_USERNAME=YOUR_DB_USERNAME

# Mật khẩu MySQL.
DB_PASSWORD=YOUR_DB_PASSWORD


# ==========================================
# Cấu hình JWT cũ
# ==========================================

# Khóa bí mật dùng cho cơ chế JWT cũ.
JWT_SECRET=YOUR_JWT_SECRET


# ==========================================
# Cấu hình Amazon Cognito
# ==========================================

# Địa chỉ Cognito User Pool phát hành JWT.
COGNITO_ISSUER_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX

# App Client ID của Amazon Cognito.
COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID

# Domain Amazon Cognito.
COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.ap-southeast-1.amazoncognito.com
