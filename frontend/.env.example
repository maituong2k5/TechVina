
# ==========================================
# Cấu hình AWS cho TechVina
# ==========================================

# Khu vực triển khai AWS.
VITE_AWS_REGION=ap-southeast-1

# User Pool ID của Amazon Cognito.
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX

# App Client ID của Amazon Cognito.
VITE_COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID

# Domain của Amazon Cognito.
VITE_COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.ap-southeast-1.amazoncognito.com

# ==========================================
# Cấu hình địa chỉ ứng dụng
# ==========================================

# Địa chỉ quay về sau khi đăng nhập.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/

# Địa chỉ quay về sau khi đăng xuất.
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Địa chỉ API Spring Boot.
VITE_API_BASE_URL=http://localhost:8080
